{
  "name": "@slg-os/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend workspace of slg-os (shell, design system, SDK, reference module, contracts).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "shell",
    "design-system",
    "sdk-frontend",
    "reference-module",
    "contracts",
    "tools"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "i18n:check": "node tools/check-i18n.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "i18next": "26.5.3",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.3",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
