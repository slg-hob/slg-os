{
  "$comment": "Schema of the token sources (PRD-0005 VL-5 AC1). Each file in design/tokens is a list of entries; the entry shape depends on the file (see $defs and TOKEN_FILES in frontend/design-tools/src/tokens.mjs). Validated by the generator with a small built-in validator, no network access.",
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 48 },
    "usage": { "type": "string", "minLength": 3, "maxLength": 300 },
    "colorValue": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(,\\s*(\\d(\\.\\d+)?|\\.\\d+)\\s*)?\\))$" },
    "forcedColor": { "type": "string", "enum": ["Canvas", "CanvasText", "LinkText", "Highlight", "HighlightText", "ButtonFace", "ButtonText", "GrayText"] },
    "color": {
      "type": "object",
      "required": ["name", "light", "dark", "usage"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "light": { "$ref": "#/$defs/colorValue" },
        "dark": { "$ref": "#/$defs/colorValue" },
        "lightHc": { "$ref": "#/$defs/colorValue" },
        "darkHc": { "$ref": "#/$defs/colorValue" },
        "forced": { "$ref": "#/$defs/forcedColor" },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "typeFamily": {
      "type": "object",
      "required": ["kind", "name", "value", "usage"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["family"] },
        "name": { "$ref": "#/$defs/name" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9 ,\"'_-]+$", "maxLength": 200 },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "typeScale": {
      "type": "object",
      "required": ["kind", "name", "size", "lineHeight", "weight", "usage"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["scale"] },
        "name": { "$ref": "#/$defs/name" },
        "size": { "type": "integer", "minimum": 10, "maximum": 96 },
        "lineHeight": { "type": "integer", "minimum": 12, "maximum": 128 },
        "weight": { "type": "integer", "enum": [300, 400, 600] },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "type": { "oneOf": [{ "$ref": "#/$defs/typeFamily" }, { "$ref": "#/$defs/typeScale" }] },
    "pixels": {
      "type": "object",
      "required": ["name", "px", "usage"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "px": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "rem": { "type": "boolean" },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "shadow": {
      "type": "object",
      "required": ["name", "light", "dark", "usage"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "light": { "type": "string", "pattern": "^[0-9a-z.,()%\\s-]+$", "maxLength": 200 },
        "dark": { "type": "string", "pattern": "^[0-9a-z.,()%\\s-]+$", "maxLength": 200 },
        "forced": { "type": "string", "enum": ["none"] },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "motion": {
      "type": "object",
      "required": ["name", "value", "usage"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "value": { "type": "string", "pattern": "^(\\d{1,4}ms|cubic-bezier\\(\\s*[0-9.]+\\s*,\\s*[0-9.]+\\s*,\\s*[0-9.]+\\s*,\\s*[0-9.]+\\s*\\))$" },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "pair": {
      "type": "object",
      "required": ["id", "fg", "bg", "role"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "fg": { "type": "string", "pattern": "^(--bs-)?[a-z][a-z0-9-]*$" },
        "bg": { "type": "string", "pattern": "^(--bs-)?[a-z][a-z0-9-]*$" },
        "role": { "type": "string", "enum": ["text", "text-enhanced", "large-text", "ui", "hairline", "disabled"] },
        "over": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "modes": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["light", "dark", "light-hc", "dark-hc"] } }
      }
    },
    "pairs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pair" } },
    "bootstrapMap": {
      "type": "object",
      "required": ["entries", "pairs"],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["bs", "token"],
            "additionalProperties": false,
            "properties": {
              "bs": { "type": "string", "pattern": "^--bs-[a-z][a-z0-9-]*$" },
              "token": { "$ref": "#/$defs/name" },
              "channels": { "type": "boolean" }
            }
          }
        },
        "pairs": { "$ref": "#/$defs/pairs" }
      }
    },
    "colorList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/color" } },
    "typeList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/type" } },
    "pixelsList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pixels" } },
    "shadowList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shadow" } },
    "motionList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/motion" } }
  }
}
